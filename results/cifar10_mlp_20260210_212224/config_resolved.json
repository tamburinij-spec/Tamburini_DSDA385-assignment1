{
  "experiment_name": "cifar10_mlp",
  "dataset": {
    "name": "cifar10",
    "root": "./data/cifar10",
    "batch_size": 128,
    "num_workers": 2,
    "problem_type": "classification",
    "val_ratio": 0.1
  },
  "model": {
    "architecture": "mlp",
    "hidden_sizes": [
      512,
      256
    ],
    "dropout": 0.5
  },
  "training": {
    "num_epochs": 40,
    "learning_rate": 0.001,
    "weight_decay": 0.0005,
    "early_stopping": {
      "enabled": true,
      "patience": 7,
      "min_delta": 0.0
    }
  }
}